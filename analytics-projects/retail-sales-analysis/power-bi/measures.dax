// Create a Date table in Power BI (Modeling > New table):
Date =
ADDCOLUMNS (
    CALENDAR ( MIN ( Sales[order_date] ), MAX ( Sales[order_date] ) ),
    "Year", YEAR ( [Date] ),
    "Month Number", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "MMM" ),
    "Year-Month", FORMAT ( [Date], "YYYY-MM" )
)

// Sort Date[Month] by Date[Month Number].
// Sort Date[Year-Month] chronologically if necessary.
// Mark Date as the model's date table and relate Date[Date] to Sales[order_date].

Total Revenue =
SUMX ( Sales, Sales[units_sold] * Sales[unit_price] )

Total Cost =
SUMX ( Sales, Sales[units_sold] * Sales[unit_cost] )

Total Profit =
[Total Revenue] - [Total Cost]

Units Sold =
SUM ( Sales[units_sold] )

Order Count =
DISTINCTCOUNT ( Sales[order_id] )

Profit Margin =
DIVIDE ( [Total Profit], [Total Revenue] )

Average Order Value =
DIVIDE ( [Total Revenue], [Order Count] )

Revenue Previous Month =
CALCULATE ( [Total Revenue], DATEADD ( 'Date'[Date], -1, MONTH ) )

Revenue MoM Change =
[Total Revenue] - [Revenue Previous Month]

Revenue MoM % =
DIVIDE ( [Revenue MoM Change], [Revenue Previous Month] )

// Optional product ranking for visual-level filters:
Product Revenue Rank =
RANKX ( ALL ( Sales[product] ), [Total Revenue], , DESC, DENSE )
